# Crisis Radar — environment variables
# Copy to .env and fill in your values.

# Anthropic API key (required for LLM research)
ANTHROPIC_API_KEY=

# Home Assistant integration (optional — needed for display push)
HA_URL=http://homeassistant:8123
HA_TOKEN=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Price feed API key (optional — enables hard numeric prices for gas/oil)
PRICE_API_KEY=

# HTTP server port (optional, default 8910)
CRISIS_RADAR_PORT=8910
